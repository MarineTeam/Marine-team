# ============================================================
# Server-side env vars for the Vercel serverless function (api/embed.js).
# Set these in Vercel → Project → Settings → Environment Variables.
# NEVER commit real values, and never put the bunny token key in js/config.js.
# ============================================================

# Auth0 tenant domain (used to verify the member's access token via /userinfo)
AUTH0_DOMAIN=your-tenant.us.auth0.com

# bunny.net Stream library that holds your sermon videos
BUNNY_LIBRARY_ID=123456

# bunny.net library → Security tab → Token Authentication key (SECRET)
BUNNY_TOKEN_AUTH_KEY=your-bunny-token-authentication-key
